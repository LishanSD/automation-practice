# Copy to .env and fill in ONE provider key matching STAGEHAND_MODEL.
# Model format: <provider>/<model> (e.g. google/gemini-2.0-flash, openai/gpt-4.1-mini)
STAGEHAND_MODEL=google/gemini-2.0-flash

# Google Gemini (get free key at https://aistudio.google.com/):
GOOGLE_GENERATIVE_AI_API_KEY=

# Or other providers:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
